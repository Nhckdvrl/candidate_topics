+        # use global_step % steps_per_epoch below to skip consumed batches.
+        if global_step > 0 and global_step % self.steps_per_epoch == 0:
+            self.current_epoch = epoch + 1
+        else:
+            self.current_epoch = epoch
        
         return global_step
