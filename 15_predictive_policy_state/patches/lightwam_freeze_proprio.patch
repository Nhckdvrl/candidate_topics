+    def _collect_lora_parameters(self, model):
+        """Trainable LoRA parameters of the frozen backbone, by name."""
+        target = model if hasattr(model, "named_parameters") else self.accelerator.unwrap_model(model)
+        return [
+            (name, param)
+            for name, param in target.named_parameters()
+            if param.requires_grad and ".lora_" in f".{name}"
+        ]
+
+    def _backward_with_lora_action_only(self, train_model, loss):
+        """Backward such that LoRA receives gradient from the action loss ONLY.
+
+        The action and video branches are separate forward passes that share parameters but
+        no activations (verified on the real model), so neither backward needs retain_graph.
+        """
+        components = getattr(train_model, "_last_loss_components", None)
+        if not components:
+            raise RuntimeError(
+                "LIGHTWAM_LORA_ACTION_ONLY=1 requires the model to expose _last_loss_components"
+            )
+        lora_params = self._collect_lora_parameters(train_model)
+        if not lora_params:
+            raise RuntimeError("LIGHTWAM_LORA_ACTION_ONLY=1 but no trainable LoRA parameters exist")
+
+        self.accelerator.backward(components["action"])
+        action_only = {
+            name: (None if param.grad is None else param.grad.detach().clone())
+            for name, param in lora_params
+        }
+        self.accelerator.backward(components["video"])
+        for name, param in lora_params:
+            saved = action_only[name]
+            if saved is None:
+                if param.grad is not None:
+                    param.grad.zero_()
+            else:
+                param.grad.copy_(saved)
+        self._lora_routing_checked = True
